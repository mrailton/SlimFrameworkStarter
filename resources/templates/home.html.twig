{% extends 'layout.html.twig' %}

{% block content %}
<div class="space-y-6">
    <!-- Hero / Welcome Card -->
    <div class="bg-white rounded-xl shadow-xs border border-slate-200 p-6 sm:p-8">
        <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Welcome to your Slim Starter App</h1>
        <p class="mt-2 text-base text-slate-600">A modern, testable, and robust starter architecture powered by <strong class="text-slate-800">Slim 4</strong>, <strong class="text-slate-800">Doctrine ORM</strong>, <strong class="text-slate-800">Twig</strong>, <strong class="text-slate-800">Tailwind CSS</strong>, and <strong class="text-slate-800">Alpine.js</strong>.</p>
    </div>

    <!-- Alpine.js Interactive Demo Widget -->
    <div class="bg-gradient-to-r from-indigo-500 to-purple-600 rounded-xl shadow-xs p-6 text-white" x-data="{ count: 0, liked: false }">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div>
                <h2 class="text-lg font-bold flex items-center gap-2">
                    <span>⚡</span>
                    <span>Alpine.js Reactive Component</span>
                </h2>
                <p class="text-indigo-100 text-sm mt-1">This component demonstrates Alpine.js reactivity running within your Twig view.</p>
            </div>
            <div class="flex items-center gap-3">
                <button @click="count++" class="px-3.5 py-1.5 bg-white/20 hover:bg-white/30 backdrop-blur-xs rounded-lg text-sm font-semibold transition cursor-pointer">
                    Clicks: <span x-text="count" class="font-mono">0</span>
                </button>
                <button @click="liked = !liked" :class="liked ? 'bg-pink-500 text-white' : 'bg-white text-indigo-700'" class="px-3.5 py-1.5 rounded-lg text-sm font-semibold transition cursor-pointer">
                    <span x-text="liked ? '❤️ Loved' : '🤍 Like'">🤍 Like</span>
                </button>
            </div>
        </div>
    </div>

    <!-- Grid of Features and Architecture -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white rounded-xl shadow-xs border border-slate-200 p-6">
            <h2 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
                <span>📦</span>
                <span>Included Stack & Features</span>
            </h2>
            <ul class="space-y-2.5 text-sm text-slate-600">
                {% for feature in features %}
                    <li class="flex items-center gap-2">
                        <span class="text-emerald-500 font-bold">✓</span>
                        <span>{{ feature }}</span>
                    </li>
                {% endfor %}
            </ul>
        </div>

        <div class="bg-white rounded-xl shadow-xs border border-slate-200 p-6 flex flex-col justify-between">
            <div>
                <h2 class="text-lg font-bold text-slate-900 mb-4 flex items-center gap-2">
                    <span>🏗️</span>
                    <span>Architecture Overview</span>
                </h2>
                <ul class="space-y-2 text-sm text-slate-600">
                    <li><code class="px-1.5 py-0.5 rounded-sm bg-slate-100 text-slate-800 text-xs font-mono">src/Controller/</code> Single Action Controllers</li>
                    <li><code class="px-1.5 py-0.5 rounded-sm bg-slate-100 text-slate-800 text-xs font-mono">src/Entity/</code> Doctrine ORM models + Attributes</li>
                    <li><code class="px-1.5 py-0.5 rounded-sm bg-slate-100 text-slate-800 text-xs font-mono">resources/templates/</code> Twig views & components</li>
                    <li><code class="px-1.5 py-0.5 rounded-sm bg-slate-100 text-slate-800 text-xs font-mono">resources/{css,js}/</code> Vite CSS & JS entrypoints</li>
                    <li><code class="px-1.5 py-0.5 rounded-sm bg-slate-100 text-slate-800 text-xs font-mono">tests/</code> PHPUnit unit & functional tests</li>
                </ul>
            </div>
            <div class="mt-6 pt-4 border-t border-slate-100">
                <a href="/users" class="inline-flex items-center justify-center w-full px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-lg shadow-xs transition">
                    Explore User Demo &rarr;
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
