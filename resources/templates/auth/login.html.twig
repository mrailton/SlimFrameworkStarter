{% extends 'layout.html.twig' %}

{% block content %}
<div class="max-w-md mx-auto my-8">
    <div class="bg-white rounded-xl shadow-xs border border-slate-200 p-8">
        <div class="text-center mb-6">
            <h2 class="text-2xl font-bold text-slate-900">Sign In</h2>
            <p class="text-sm text-slate-500 mt-1">Please enter your credentials to access protected pages.</p>
        </div>

        {% if errors.auth is defined %}
            <div class="mb-5 p-4 rounded-lg bg-red-50 border border-red-200 text-sm text-red-700 flex items-center gap-2">
                <span>⚠️</span>
                <span>{{ errors.auth }}</span>
            </div>
        {% endif %}

        <form action="/login" method="POST" class="space-y-4">
            <div>
                <label for="email" class="block text-sm font-medium text-slate-700 mb-1">Email</label>
                <input type="email" id="email" name="email" value="{{ form.email|default('') }}" required autofocus
                       class="w-full px-3.5 py-2 rounded-lg border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm transition">
                {% if errors.email is defined %}
                    <p class="text-xs text-red-600 mt-1">{{ errors.email }}</p>
                {% endif %}
            </div>

            <div>
                <label for="password" class="block text-sm font-medium text-slate-700 mb-1">Password</label>
                <input type="password" id="password" name="password" required
                       class="w-full px-3.5 py-2 rounded-lg border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 text-sm transition">
                {% if errors.password is defined %}
                    <p class="text-xs text-red-600 mt-1">{{ errors.password }}</p>
                {% endif %}
            </div>

            <button type="submit" class="w-full py-2.5 px-4 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold rounded-lg shadow-xs text-sm transition cursor-pointer">
                Sign In
            </button>
        </form>
    </div>
</div>
{% endblock %}
