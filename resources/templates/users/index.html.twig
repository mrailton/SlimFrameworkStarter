{% extends 'layout.html.twig' %}

{% block content %}
<div class="space-y-6">
    <!-- Header / Overview -->
    <div class="bg-white rounded-xl shadow-xs border border-slate-200 p-6 sm:p-8">
        <h2 class="text-2xl font-bold text-slate-900">User Management</h2>
        <p class="mt-1 text-sm text-slate-500">This demonstrates Doctrine ORM persistence integrated with Twig views, Tailwind CSS styling, and form submission.</p>
    </div>

    <!-- Add New User Form Card -->
    <div class="bg-white rounded-xl shadow-xs border border-slate-200 p-6" x-data="{ showForm: true }">
        <div class="flex items-center justify-between pb-4 border-b border-slate-100">
            <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                <span>👤</span>
                <span>Add New User</span>
            </h3>
            <button @click="showForm = !showForm" type="button" class="text-xs font-medium text-indigo-600 hover:text-indigo-800 transition">
                <span x-text="showForm ? 'Hide Form' : 'Show Form'">Hide Form</span>
            </button>
        </div>

        <form x-show="showForm" action="/users" method="POST" class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
            <div>
                <label for="name" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Name</label>
                <input type="text" id="name" name="name" value="{{ form.name|default('') }}" required
                       class="w-full px-3 py-2 rounded-lg border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-indigo-500 text-sm">
                {% if errors.name is defined %}
                    <p class="text-xs text-red-600 mt-1">{{ errors.name }}</p>
                {% endif %}
            </div>

            <div>
                <label for="email" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Email</label>
                <input type="email" id="email" name="email" value="{{ form.email|default('') }}" required
                       class="w-full px-3 py-2 rounded-lg border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-indigo-500 text-sm">
                {% if errors.email is defined %}
                    <p class="text-xs text-red-600 mt-1">{{ errors.email }}</p>
                {% endif %}
            </div>

            <div>
                <label for="password" class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-1">Password</label>
                <input type="password" id="password" name="password" required minlength="6"
                       class="w-full px-3 py-2 rounded-lg border border-slate-300 focus:outline-hidden focus:ring-2 focus:ring-indigo-500 text-sm">
                {% if errors.password is defined %}
                    <p class="text-xs text-red-600 mt-1">{{ errors.password }}</p>
                {% endif %}
            </div>

            <div class="sm:col-span-3 flex justify-end pt-2">
                <button type="submit" class="px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-semibold rounded-lg shadow-xs transition cursor-pointer">
                    Create User
                </button>
            </div>
        </form>
    </div>

    <!-- Users Table Card -->
    <div class="bg-white rounded-xl shadow-xs border border-slate-200 overflow-hidden">
        <div class="p-6 border-b border-slate-100 flex items-center justify-between">
            <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                <span>📋</span>
                <span>Existing Users</span>
                <span class="ml-2 px-2.5 py-0.5 text-xs font-semibold bg-indigo-50 text-indigo-700 rounded-full">{{ users|length }}</span>
            </h3>
        </div>

        {% if users is empty %}
            <div class="p-8 text-center text-slate-500 text-sm">
                No users found in database. Create one using the form above!
            </div>
        {% else %}
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-200 text-left text-sm">
                    <thead class="bg-slate-50">
                        <tr>
                            <th class="px-6 py-3 font-semibold text-slate-700">ID</th>
                            <th class="px-6 py-3 font-semibold text-slate-700">Name</th>
                            <th class="px-6 py-3 font-semibold text-slate-700">Email</th>
                            <th class="px-6 py-3 font-semibold text-slate-700">Created At</th>
                            <th class="px-6 py-3 font-semibold text-slate-700">Updated At</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200">
                        {% for user in users %}
                            <tr class="hover:bg-slate-50 transition">
                                <td class="px-6 py-4 font-mono text-xs text-slate-500">{{ user.id }}</td>
                                <td class="px-6 py-4 font-medium text-slate-900">{{ user.name }}</td>
                                <td class="px-6 py-4 text-slate-600">{{ user.email }}</td>
                                <td class="px-6 py-4 text-slate-500">{{ user.createdAt|date('Y-m-d H:i:s') }}</td>
                                <td class="px-6 py-4 text-slate-500">{{ user.updatedAt ? user.updatedAt|date('Y-m-d H:i:s') : '-' }}</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}
