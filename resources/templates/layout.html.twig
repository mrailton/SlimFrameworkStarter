<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ page_title|default('Slim Starter') }}</title>
    {{ vite(['resources/css/app.css', 'resources/js/app.js']) }}
    {% block head %}{% endblock %}
</head>
<body class="min-h-full flex flex-col font-sans text-slate-800 antialiased selection:bg-indigo-500 selection:text-white">
    <header class="bg-white border-b border-slate-200 shadow-xs sticky top-0 z-40" x-data="{ mobileMenuOpen: false }">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <div class="flex items-center space-x-3">
                    <a href="/" class="flex items-center space-x-2 text-indigo-600 font-bold text-xl hover:text-indigo-700 transition">
                        <span>🚀</span>
                        <span>Slim Starter</span>
                    </a>
                </div>

                <!-- Desktop Navigation -->
                <nav class="hidden sm:flex items-center space-x-6 text-sm font-medium">
                    <a href="/" class="text-slate-600 hover:text-indigo-600 transition">Home</a>
                    <a href="/users" class="text-slate-600 hover:text-indigo-600 transition">Users</a>
                    {% if auth and auth.check() %}
                        <div class="flex items-center space-x-3 pl-3 border-l border-slate-200">
                            <span class="text-slate-500">Signed in as <strong class="text-slate-700">{{ auth.user().name }}</strong></span>
                            <a href="/logout" class="inline-flex items-center px-3 py-1.5 border border-slate-300 text-xs font-medium rounded-md text-slate-700 bg-white hover:bg-slate-50 transition">Logout</a>
                        </div>
                    {% else %}
                        <a href="/login" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md text-white bg-indigo-600 hover:bg-indigo-700 shadow-xs transition">Login</a>
                    {% endif %}
                </nav>

                <!-- Mobile Menu Button -->
                <div class="sm:hidden flex items-center">
                    <button @click="mobileMenuOpen = !mobileMenuOpen" type="button" class="text-slate-500 hover:text-slate-700 p-2 rounded-md focus:outline-hidden focus:ring-2 focus:ring-indigo-500">
                        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path x-show="!mobileMenuOpen" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                            <path x-show="mobileMenuOpen" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                        </svg>
                    </button>
                </div>
            </div>
        </div>

        <!-- Mobile Navigation Menu -->
        <div x-show="mobileMenuOpen" x-cloak class="sm:hidden border-b border-slate-200 bg-white px-4 pt-2 pb-4 space-y-2">
            <a href="/" class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:bg-slate-50">Home</a>
            <a href="/users" class="block px-3 py-2 rounded-md text-base font-medium text-slate-700 hover:bg-slate-50">Users</a>
            {% if auth and auth.check() %}
                <div class="pt-3 border-t border-slate-200">
                    <div class="px-3 py-1 text-xs text-slate-500">Signed in as <strong class="text-slate-700">{{ auth.user().name }}</strong></div>
                    <a href="/logout" class="block px-3 py-2 rounded-md text-base font-medium text-red-600 hover:bg-red-50">Logout</a>
                </div>
            {% else %}
                <a href="/login" class="block px-3 py-2 rounded-md text-base font-medium text-indigo-600 hover:bg-indigo-50">Login</a>
            {% endif %}
        </div>
    </header>

    <main class="grow max-w-6xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
        {% block content %}{% endblock %}
    </main>

    <footer class="bg-white border-t border-slate-200 py-6 text-center text-sm text-slate-500">
        <div class="max-w-6xl mx-auto px-4">
            <p>Built with Slim Framework 4, Doctrine ORM, Twig, PHP-DI, Tailwind CSS & Alpine.js</p>
        </div>
    </footer>
</body>
</html>
