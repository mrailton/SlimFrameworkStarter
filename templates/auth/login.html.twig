{% extends 'layout.html.twig' %}

{% block content %}
<div class="card" style="max-width: 480px; margin: 2rem auto;">
    <h2>Sign In</h2>
    <p>Please enter your credentials to access protected pages.</p>

    {% if errors.auth is defined %}
        <div class="alert-error">{{ errors.auth }}</div>
    {% endif %}

    <form action="/login" method="POST">
        <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" value="{{ form.email|default('') }}" required autofocus>
            {% if errors.email is defined %}
                <div class="error-message">{{ errors.email }}</div>
            {% endif %}
        </div>

        <div class="form-group">
            <label for="password">Password</label>
            <input type="password" id="password" name="password" required>
            {% if errors.password is defined %}
                <div class="error-message">{{ errors.password }}</div>
            {% endif %}
        </div>

        <button type="submit" class="btn" style="width: 100%;">Sign In</button>
    </form>
</div>
{% endblock %}
