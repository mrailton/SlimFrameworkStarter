{
    "name": "mrailton/slim-example",
    "description": "An example Slim Framework application",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Mark Railton",
            "email": "mark.railton@outlook.ie"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.5.0",
        "slim/slim": "^4.15",
        "slim/psr7": "^1.8",
        "php-di/php-di": "^7.1",
        "php-di/slim-bridge": "^3.4",
        "twig/twig": "^3.30",
        "slim/twig-view": "^3.4",
        "vlucas/phpdotenv": "^5.7",
        "doctrine/orm": "^3.7",
        "doctrine/migrations": "^3.9",
        "monolog/monolog": "^3.12",
        "symfony/console": "^8.1",
        "symfony/cache": "^8.1",
        "slim/csrf": "^1.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4",
        "rector/rector": "^2.7",
        "laravel/pint": "^1.32"
    },
    "scripts": {
        "serve": [
            "@composer install",
            "php -S localhost:8000 -t public public/index.php"
        ],
        "test": [
            "php vendor/bin/phpunit"
        ],
        "format": [
            "vendor/bin/rector",
            "vendor/bin/pint"
        ]
    }
}
